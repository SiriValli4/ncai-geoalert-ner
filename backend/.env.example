# Copy to .env and fill in to send real SMS via Twilio.
# Leave unset (or delete this file) to run dispatchAlertsRoute.js in mock
# mode -- it will log what it would have sent instead of calling Twilio.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Provide EITHER a from-number OR a messaging service SID, not necessarily both.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
