# Copy to .env for local development. Every value here has a safe default in
# app/core/config.py except DATABASE_URL in production.

ENVIRONMENT=local            # local | staging | production
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Browser origins allowed to call the API: comma-separated list, or JSON list.
# The React dev server runs on :3000. Production example:
#   CORS_ORIGINS=https://geoalert-ner.vercel.app
# "*" allows any origin (no credentials) and is rejected unless ENVIRONMENT=local.
CORS_ORIGINS=http://localhost:3000

# --- PostGIS ---------------------------------------------------------------
# Must use the asyncpg driver. Alembic reuses this URL.
DATABASE_URL=postgresql+asyncpg://geoalert:geoalert@localhost:5432/geoalert
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- ML models -------------------------------------------------------------
# A missing model file does not stop the API; its endpoints return 503.
RISK_MODEL_PATH=ml/models/landslide_risk_model.joblib
HAZARD_MODEL_PATH=ml/models/hazard_yolov8_demo.pt
HAZARD_CONF_DEFAULT=0.25
HAZARD_MAX_DIM=1280
MAX_UPLOAD_MB=15

# --- Field report photo storage ---------------------------------------------
MEDIA_DIR=media
MEDIA_URL_PREFIX=/media

# --- Weather ingestion (OpenWeatherMap) ---------------------------------------
# Hourly rainfall, humidity and temperature per target -> realtime_weather_logs. Enable on ONE
# process only (API replicas each run their own scheduler). Or run it as its own
# worker: python -m app.services.weather_ingestion   (add --once for a single pass)
WEATHER_INGESTION_ENABLED=false
OPENWEATHER_API_KEY=
WEATHER_INGEST_INTERVAL_MINUTES=60
WEATHER_TARGETS=[{"name":"Gangtok","latitude":27.3389,"longitude":88.6065},{"name":"Shillong","latitude":25.5788,"longitude":91.8933},{"name":"Haflong","latitude":25.1700,"longitude":93.0200},{"name":"Aizawl","latitude":23.7271,"longitude":92.7176},{"name":"Kohima","latitude":25.6751,"longitude":94.1086}]
