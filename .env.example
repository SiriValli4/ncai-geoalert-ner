# Copy to .env for local development. Every value here has a safe default in
# app/core/config.py except DATABASE_URL in production.

ENVIRONMENT=local            # local | staging | production
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Comma-separated list, or JSON list. The React dev server runs on :3000.
CORS_ORIGINS=http://localhost:3000

# --- PostGIS ---------------------------------------------------------------
# Must use the asyncpg driver. Alembic reuses this URL.
DATABASE_URL=postgresql+asyncpg://geoalert:geoalert@localhost:5432/geoalert
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- ML models -------------------------------------------------------------
# A missing model file does not stop the API; its endpoints return 503.
RISK_MODEL_PATH=ml/models/landslide_risk_model.joblib
HAZARD_MODEL_PATH=ml/models/hazard_yolov8_demo.pt
HAZARD_CONF_DEFAULT=0.25
HAZARD_MAX_DIM=1280
MAX_UPLOAD_MB=15

# --- Field report photo storage ---------------------------------------------
MEDIA_DIR=media
MEDIA_URL_PREFIX=/media
